{
  "name": "maze-of-the-minotaur",
  "version": "0.9.1",
  "homepage": "http://itsericwoodward.github.io/maze-of-the-minotaur",
  "type": "module",
  "scripts": {
    "build": "BUILD_ENV=production node ./build.js",
    "build:android": "NODE_ENV=production && yarn tauri android build",
    "build:gh-pages": "NODE_ENV=production tsc && vite build --config vite.config.gh-pages.js",
    "build:webtoys": "NODE_ENV=production tsc && vite build --config vite.config.webtoys.js",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/debug": "^4.1.12",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "debug": "^4.4.3",
    "supports-color": "^10.2.2"
  },
  "packageManager": "yarn@4.9.4"
}
